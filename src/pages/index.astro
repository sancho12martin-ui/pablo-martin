    color: var(--accent);
    opacity: 0.7;
    flex-shrink: 0;
  }

  .infos-nom {
    font-size: 13px;
    letter-spacing: 0.5px;
    color: var(--text-muted);
  }

  .dot {
    color: var(--border);
    font-size: 10px;
  }

  .cameras-bloc {
    display: flex;
    flex-direction: column;
