    border: none;
    padding: 0;
    cursor: pointer;
    display: block;
    width: 100%;
    height: 100%;
  }
  .mosaique-item img {
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
    pointer-events: none;
  }
  .mosaique-item:hover img { transform: scale(1.10); }

  /* ── INFOS BAS ── */
  .film-infos-bas {
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .infos-ligne {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 4px;
  }

  .infos-item-ligne {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }

  .infos-item {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .sep-inline {
    color: var(--text-muted);
    opacity: 0.9;
    margin: 0 4px;
    font-size: 16px;
    line-height: 1;
  }

  .infos-row {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .infos-poste {
    font-size: 12px;
    letter-spacing: 1.5px;
