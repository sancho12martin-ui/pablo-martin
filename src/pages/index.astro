---
import Layout from '../layouts/Layout.astro';
import { getFilmImages } from '../lib/cloudinary.js';
import { getFilms } from '../lib/queries.ts';
import { site } from '../config/site.ts';

const norm = (s: string) =>
  (s || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();

// Ne garde que les crédits étoilés, regroupés par catégorie
function creditsAffiches(credits: any[] = []) {
  const items = (credits || []).filter((c: any) => c.afficher && c.nom && c.poste);

  const estProd = (p: string) => norm(p) === 'production' || norm(p).includes('producteur');
  const estAssCam = (p: string) => norm(p).includes('assistant camera') || norm(p).includes('assistante camera');
  const estPresta = (p: string) => norm(p).includes('prestataire');

  // 1er, 2ème, 3ème assistant : triés par rang
  const rang = (p: string) => { const n = parseInt(p); return isNaN(n) ? 9 : n; };

  const groupes: { label: string; noms: string[] }[] = [];

  const prod = items.filter((c: any) => estProd(c.poste));
  if (prod.length) groupes.push({ label: 'Prod.', noms: prod.map((c: any) => c.nom) });

  const cam = items.filter((c: any) => estAssCam(c.poste)).sort((a: any, b: any) => rang(a.poste) - rang(b.poste));
  if (cam.length) groupes.push({ label: 'Ass. Cam.', noms: cam.map((c: any) => c.nom) });

  const presta = items.filter((c: any) => estPresta(c.poste));
  if (presta.length) groupes.push({ label: 'Prestataire', noms: presta.map((c: any) => c.nom) });

  // Tout autre poste étoilé : sa propre ligne
  items
    .filter((c: any) => !estProd(c.poste) && !estAssCam(c.poste) && !estPresta(c.poste))
    .forEach((c: any) => groupes.push({ label: c.poste, noms: [c.nom] }));

  return groupes;
}

const filmsData = await getFilms();

const filmsAvecImages = await Promise.all(
  filmsData.map(async (film: any) => {
    const { cover, images_film, prix } = await getFilmImages(film.slug);
    return {
      ...film,
      cover: cover || null,
      photos: images_film,
      prixImage: prix || null,
      creditsBas: creditsAffiches(film.credits),
    };
  })
);

const reseaux = site.reseaux;
const vimeoId = site.hero.vimeoId;

const tousLesRoles = [...new Set(filmsAvecImages.flatMap((f: any) => f.roles || []))].sort();

const nbParRole: Record<string, number> = {};
filmsAvecImages.forEach((f: any) =>
  (f.roles || []).forEach((r: string) => { nbParRole[r] = (nbParRole[r] || 0) + 1; })
);
---

<Layout title="Pablo Martin — Directeur de la Photographie">

  <section class="hero">
    <div class="video-bg">
      <iframe
        src={`https://player.vimeo.com/video/${vimeoId}?autoplay=1&muted=1&loop=1&background=1`}
        frameborder="0"
        allow="autoplay; fullscreen"
        allowfullscreen
      ></iframe>
    </div>
    <div class="overlay-top"></div>
    <div class="overlay-bottom"></div>
    <div class="hero-content">
      <div class="hero-info">
        <div class="hero-textes">
          <h1 class="hero-nom">Pablo Martin</h1>
          <p class="hero-fonction">Directeur de la Photographie</p>
        </div>
        <div class="reseaux">
          {reseaux.map((r) => (
            r.actif ? (
              <a href={r.url} target="_blank" rel="noopener" class="reseau-btn actif" aria-label={r.nom}>
                <span class="reseau-icone">
                  <img src={r.img} alt={r.nom} class={`reseau-img ${r.classe || ''}`} />
                </span>
              </a>
            ) : (
              <span class="reseau-btn inactif" title={`${r.nom} — bientôt disponible`}>
                <span class="reseau-icone">
                  <img src={r.img} alt={r.nom} class={`reseau-img inactif-img ${r.classe || ''}`} />
                </span>
              </span>
            )
          ))}
        </div>
      </div>
      <a href="#nav-onglets" class="scroll-hint">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
          <path d="M10 4v12M4 10l6 6 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </section>

  <nav class="onglets" id="nav-onglets">
    <button type="button" class="onglet actif onglet-filtre" id="btn-filtres" aria-expanded="false" aria-controls="panneau-filtres">
      Narratif
      <span class="filtre-badge" id="filtre-badge"></span>
      <svg class="chevron" width="10" height="6" viewBox="0 0 10 6" aria-hidden="true">
        <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round"/>
      </svg>
    </button>
    <a href="/video" class="onglet">Vidéo</a>
    <a href="/etalonnage" class="onglet">Étalonnage</a>
    <a href="/timeline" class="onglet">Timeline</a>
    <a href="/contact" class="onglet">Contact</a>
  </nav>

  <div class="panneau-filtres" id="panneau-filtres" role="region" aria-label="Filtres">
    <div class="pf-section">
      <p class="pf-titre">Voir Pablo en tant que…</p>
      {tousLesRoles.map((role: string) => (
        <label class="pf-check">
          <input type="checkbox" name="role" value={role} />
          <span class="pf-boite"></span>
          <span class="pf-texte">{role}</span>
          <span class="pf-nb">{nbParRole[role]}</span>
        </label>
      ))}
    </div>

    <div class="pf-section">
      <p class="pf-titre">Trier par année</p>
      <label class="pf-radio">
        <input type="radio" name="tri" value="desc" checked />
        <span class="pf-boite"></span>
        <span class="pf-texte">Plus récent</span>
      </label>
      <label class="pf-radio">
        <input type="radio" name="tri" value="asc" />
        <span class="pf-boite"></span>
        <span class="pf-texte">Plus ancien</span>
      </label>
    </div>

    <div class="pf-pied">
      <button type="button" class="filtre-reset" id="filtre-reset">Réinitialiser</button>
      <span class="pf-resultat" id="pf-resultat"></span>
    </div>
  </div>

  <section class="films-liste" id="narratif">
    {filmsAvecImages.map((film: any) => (
      <article class="film-card" data-roles={JSON.stringify(film.roles || [])} data-annee={String(film.annee)}>

        <div class="film-header">
          <h2 class="film-titre">
            <a href={`/narratif/${film.slug}`}>{film.titre}</a>
          </h2>
          <div class="film-meta">
            {film.genre && <span class="film-genre-label">{film.genre}</span>}
            {film.duree && <><span class="sep">·</span><span class="film-duree">{film.duree}</span></>}
            {film.pays && <><span class="sep">·</span><span>{film.pays}</span></>}
            {film.annee && <><span class="sep">·</span><span>{film.annee}</span></>}
          </div>
          <p class="film-real"><span class="real-label">Réal.</span> {film.real}</p>
          <div class="film-roles">
            {film.roles.map((role: string) => (
              <span class="role-tag">{role}</span>
            ))}
          </div>
          {film.prix && (
            <div class="film-prix-bandeau">
              {film.prixImage && (
                <img src={film.prixImage} alt={`Prix — ${film.titre}`} class="film-prix-bandeau-logo" />
              )}
              <span class="film-prix-bandeau-texte">🏆 {film.prix}</span>
            </div>
          )}
          {film.mubi && (
            <a href={film.mubi} target="_blank" rel="noopener noreferrer" class="bandeau-mubi">
              <img src="/images/mubi_logo.png" alt="MUBI" class="mubi-logo" />
              <span class="mubi-texte">Disponible sur MUBI</span>
              <span class="mubi-arrow">↗</span>
            </a>
          )}
        </div>

        <div class="film-visuel">
          <a href={`/narratif/${film.slug}`} class="film-cover">
            {film.cover ? (
              <img src={film.cover} alt={film.titre} loading="lazy" />
            ) : (
              <div class="cover-placeholder">
                <span>Image bientôt disponible</span>
              </div>
            )}
            <div class="film-cover-overlay">
              <span class="voir-projet">Voir le projet →</span>
            </div>
          </a>

          <div class="film-mosaique" data-photos={JSON.stringify(film.photos)}>
            {film.photos.slice(0, 12).map((photo: string, i: number) => (
              <button
                class="mosaique-item"
                data-index={String(i)}
                aria-label={`Agrandir photo ${i + 1}`}
              >
                <img src={photo} alt={`${film.titre} — ${i + 1}`} loading="lazy" />
              </button>
            ))}
          </div>
        </div>

        <div class="film-infos-bas">
          {film.creditsBas.length > 0 && (
            <div class="infos-ligne">
              {film.creditsBas.map((g: any) => (
                <p class="infos-item-ligne">
                  <span class="infos-poste">{g.label}</span>
                  {g.noms.map((nom: string, i: number) => (
                    <span class="infos-item">
                      {i > 0 && <span class="sep-inline">·</span>}
                      <span class="infos-nom">{nom}</span>
                    </span>
                  ))}
                </p>
              ))}
            </div>
          )}
          {film.cameras && (
            <div class="cameras-bloc">
              {film.cameras.map((cam: any) => (
                <div class="infos-row camera-row">
                  <span class="camera-emoji">{cam.type === 'numerique' ? '📹' : '🎥'}</span>
                  <span class="infos-nom">{cam.nom}</span>
                  {cam.format && <><span class="dot">/</span><span class="infos-nom">{cam.format}</span></>}
                  {cam.laboratoire && <><span class="dot">/</span><span class="infos-nom">Labo. {cam.laboratoire}</span></>}
                  {cam.type === 'numerique' && cam.optiques && <><span class="dot">/</span><span class="infos-nom">{cam.optiques}</span></>}
                </div>
              ))}
            </div>
          )}
        </div>

        <div class="film-separateur"></div>
      </article>
    ))}
  </section>

  <div class="lightbox" id="lightbox">
    <div class="lightbox-bg" id="lightbox-bg"></div>
    <button class="lightbox-close" id="lightbox-close">✕</button>
    <button class="lightbox-prev" id="lightbox-prev">‹</button>
    <button class="lightbox-next" id="lightbox-next">›</button>
    <img class="lightbox-img" id="lightbox-img" src="" alt="" />
    <p class="lightbox-counter" id="lightbox-counter"></p>
  </div>

</Layout>

<style>
  /* ── HERO ── */
  .hero {
    position: relative;
    width: 100%;
    height: 80vh;
    min-height: 500px;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
  }

  .video-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .video-bg iframe {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100vw;
    height: 56.25vw;
    min-height: 100%;
    min-width: 177.78vh;
    transform: translate(-50%, -50%);
    border: none;
  }

  .overlay-top {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 40%;
    background: linear-gradient(to bottom, var(--bg), transparent);
    z-index: 1;
  }

  .overlay-bottom {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 70%;
    background: linear-gradient(to top, var(--bg) 15%, transparent);
    z-index: 1;
  }

  .hero-content {
    position: relative;
    z-index: 3;
    width: 100%;
    padding: 0 56px 36px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
  }

  .hero-info {
    display: flex;
    flex-direction: column;
    gap: 0.5vh;
    opacity: 0;
    transform: translateY(20px);
    animation: fadeUp 0.8s ease 1s forwards;
    width: fit-content;
  }

  .hero-textes {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .hero-nom {
    font-family: Helvetica, Arial, sans-serif;
    font-weight: 800;
    font-size: 96px;
    line-height: 1;
    letter-spacing: 4px;
    color: #ffffff;
    text-shadow: 0 2px 4px rgba(0,0,0,0.9), 0 4px 24px rgba(0,0,0,0.8);
    white-space: nowrap;
    margin-left: -4px;
  }

  .hero-fonction {
    font-family: Helvetica, Arial, sans-serif;
    font-weight: 800;
    font-size: 32px;
    line-height: 1;
    text-transform: uppercase;
    color: #ffffff;
    text-shadow: 0 2px 4px rgba(0,0,0,0.9), 0 4px 24px rgba(0,0,0,0.8);
    white-space: nowrap;
    letter-spacing: 3px;
  }

  .reseaux {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-top: 0.5vh;
    width: 100%;
  }

  .reseau-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.2s;
  }

  .reseau-btn.actif { color: rgba(255,255,255,0.9); cursor: pointer; }
  .reseau-btn.actif:hover { color: var(--accent); }
  .reseau-btn.inactif { color: rgba(255,255,255,0.4); opacity: 0.35; cursor: not-allowed; }

  .reseau-icone {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    flex-shrink: 0;
  }

  .reseau-img {
    width: clamp(20px, 2.5vw, 36px);
    height: clamp(20px, 2.5vw, 36px);
    object-fit: contain;
    object-position: bottom;
    filter: brightness(0) invert(1);
    transition: filter 0.2s;
    display: block;
  }

  .imdb-img {
    width: clamp(34px, 4vw, 58px) !important;
    height: clamp(34px, 4vw, 58px) !important;
  }

  .mail-img {
    width: clamp(22px, 2.8vw, 39px) !important;
    height: clamp(22px, 2.8vw, 39px) !important;
  }

  .lighty-img {
    width: clamp(24px, 3vw, 42px) !important;
    height: clamp(24px, 3vw, 42px) !important;
  }

  .reseau-btn.actif:hover .reseau-img {
    filter: brightness(0) saturate(100%) invert(93%) sepia(61%) saturate(600%) hue-rotate(10deg) brightness(103%);
  }

  .inactif-img { opacity: 0.5; }

  .scroll-hint {
    color: rgba(255,255,255,0.5);
    opacity: 0;
    animation: fadeIn 0.8s ease 1.8s forwards;
    transition: color 0.2s;
    padding-bottom: 8px;
  }
  .scroll-hint:hover { color: var(--accent); }

  /* ── BOUTON RÉINITIALISER ── */
  .filtre-reset {
    font-size: 10px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--text-muted);
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s, color 0.2s;
  }

  .filtre-reset.visible {
    opacity: 1;
    pointer-events: all;
  }

  .filtre-reset:hover { color: var(--accent); }

  .film-card.masque { display: none; }

  /* ── ONGLET NARRATIF + PANNEAU DE FILTRES ── */
  .onglet-filtre {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: none;
    border: 0;
    border-bottom: 2px solid transparent;
    font-family: inherit;
    font-size: 12px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--text-muted);
    padding: 20px 24px;
    white-space: nowrap;
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s;
  }
  .onglets .onglet-filtre.actif { color: var(--accent); border-bottom-color: var(--accent); }
  .onglet-filtre:hover { color: var(--text); }
  .onglets .onglet-filtre.actif:hover { color: var(--accent); }

  .chevron {
    transition: transform 0.25s ease;
    animation: invite 1.2s ease 2s 3;
  }
  .onglet-filtre[aria-expanded="true"] .chevron {
    transform: rotate(180deg);
    animation: none;
  }
  @keyframes invite {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(3px); }
  }

  .filtre-badge {
    display: none;
    min-width: 18px;
    height: 18px;
    padding: 0 5px;
    border-radius: 9px;
    background: var(--accent);
    color: var(--bg);
    font-size: 10px;
    letter-spacing: 0;
    font-weight: 800;
    align-items: center;
    justify-content: center;
  }
  .filtre-badge.visible { display: inline-flex; }

  .panneau-filtres {
    position: fixed;
    z-index: 60;
    width: min(400px, calc(100vw - 32px));
    max-height: calc(100vh - 100px);
    overflow-y: auto;
    background: var(--bg);
    border: 1px solid var(--border);
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.5);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 24px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
  }
  .panneau-filtres.ouvert {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  .pf-section { display: flex; flex-direction: column; gap: 2px; }

  .pf-titre {
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 8px;
  }

  .pf-check, .pf-radio {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 0;
    cursor: pointer;
    font-size: 13px;
    letter-spacing: 1px;
    color: var(--text-muted);
    transition: color 0.2s;
  }
  .pf-check:hover, .pf-radio:hover { color: var(--text); }
  .pf-check input, .pf-radio input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .pf-boite {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s, border-color 0.2s;
  }
  .pf-radio .pf-boite { border-radius: 50%; }

  .pf-check input:checked + .pf-boite { background: var(--accent); border-color: var(--accent); }
  .pf-check input:checked + .pf-boite::after {
    content: '';
    width: 4px;
    height: 8px;
    border: solid var(--bg);
    border-width: 0 2px 2px 0;
    transform: rotate(45deg) translate(-1px, -1px);
  }
  .pf-radio input:checked + .pf-boite { border-color: var(--accent); }
  .pf-radio input:checked + .pf-boite::after {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
  }
  .pf-check input:checked ~ .pf-texte,
  .pf-radio input:checked ~ .pf-texte { color: var(--text); }
  .pf-check input:focus-visible + .pf-boite,
  .pf-radio input:focus-visible + .pf-boite { outline: 1px solid var(--accent); outline-offset: 2px; }

  .pf-nb { margin-left: auto; font-size: 11px; opacity: 0.5; }

  .pf-pied {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 16px;
    border-top: 1px solid var(--border);
  }
  .pf-resultat {
    font-size: 11px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-left: auto;
  }

  /* ── FILMS ── */
  .films-liste {
    padding: 32px 56px;
    display: flex;
    flex-direction: column;
  }

  .film-card { padding: 48px 0; }

  .film-separateur {
    height: 1px;
    background: var(--border);
    margin-top: 48px;
  }
  .film-card:last-child .film-separateur { display: none; }

  .film-header {
    margin-bottom: 20px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .film-titre {
    font-family: Helvetica, Arial, sans-serif;
    font-weight: 800;
    font-size: 38px;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--text);
  }
  .film-titre a:hover { color: var(--accent); }

  .film-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .film-duree { text-transform: none; }

  .sep {
    color: var(--text-muted);
    font-size: 20px;
    line-height: 1;
    opacity: 0.8;
  }

  .film-genre-label { color: var(--accent); }

  .film-real {
    font-size: 13px;
    letter-spacing: 1px;
    color: var(--text-muted);
  }

  .real-label { color: var(--accent); }

  .film-roles {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .role-tag {
    font-size: 13px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--text-muted);
    border: 1px solid var(--border);
    padding: 4px 12px;
    font-weight: 800;
  }

  .film-prix-bandeau {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 16px 24px;
    background: linear-gradient(90deg, rgba(232, 255, 0, 0.12) 0%, transparent 100%);
    border-left: 2px solid var(--accent);
    width: 100%;
    transition: all 0.3s ease;
  }

  .film-prix-bandeau:hover {
    background: linear-gradient(90deg, rgba(232, 255, 0, 0.18) 0%, transparent 100%);
    transform: translateX(4px);
  }

  .film-prix-bandeau-logo {
    height: 80px;
    width: auto;
    object-fit: contain;
    filter: brightness(1.3) drop-shadow(0 0 10px rgba(232, 255, 0, 0.25));
  }

  .film-prix-bandeau-texte {
    font-size: 14px;
    letter-spacing: 2px;
    text-transform: uppercase;
