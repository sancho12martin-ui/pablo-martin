      white-space: normal;
    }

    .reseaux { margin-top: 12px; }

    .reseau-img {
      width: 22px !important;
      height: 22px !important;
    }

    .imdb-img {
      width: 32px !important;
      height: 32px !important;
    }

    .scroll-hint { display: none; }

    .onglet-filtre { font-size: 10px; padding: 16px 12px; letter-spacing: 1px; }
    .panneau-filtres { padding: 20px; }

    .films-liste { padding: 24px 20px; }

    .film-card { padding: 32px 0; }

    .film-separateur { margin-top: 32px; }

    .film-titre { font-size: 26px; }

    .film-meta {
      font-size: 10px;
      gap: 6px;
      flex-wrap: wrap;
    }

    .film-roles { gap: 6px; }

    .role-tag {
      font-size: 10px;
      padding: 3px 8px;
    }

    .film-prix-bandeau {
      gap: 12px;
      padding: 12px 16px;
    }

    .film-prix-bandeau-logo { height: 48px; }
    .film-prix-bandeau-texte { font-size: 11px; }

    .film-visuel {
      grid-template-columns: 1fr;
      gap: 4px;
    }

    .film-cover { min-height: 240px; }
    .cover-placeholder { min-height: 240px; }

    .film-mosaique {
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      grid-template-rows: repeat(2, 1fr);
      gap: 3px;
      height: auto;
      aspect-ratio: 3 / 1;
    }

    .film-infos-bas {
      margin-top: 12px;
      padding-top: 12px;
      gap: 8px;
    }

    .infos-ligne {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }

    .infos-item-ligne { flex-wrap: nowrap; }

    .infos-nom { font-size: 11px; }
    .infos-poste { font-size: 10px; }

    .cameras-bloc { gap: 8px; }

    .camera-row {
      flex-wrap: wrap;
      gap: 4px;
    }

    .bandeau-mubi {
      width: 100%;
      justify-content: center;
    }
  }
</style>

<script is:inline>
  // ── FILTRES ──
  const nav = document.getElementById('nav-onglets');
  const btnFiltres = document.getElementById('btn-filtres');
  const panneau = document.getElementById('panneau-filtres');
  const badge = document.getElementById('filtre-badge');
  const filtreReset = document.getElementById('filtre-reset');
  const resultat = document.getElementById('pf-resultat');
  const filmsListe = document.getElementById('narratif');
  const cards = Array.from(document.querySelectorAll('.film-card'));
  const checks = Array.from(document.querySelectorAll('input[name="role"]'));
  const radios = Array.from(document.querySelectorAll('input[name="tri"]'));

  function positionner() {
    const nb = nav.getBoundingClientRect();
    const bb = btnFiltres.getBoundingClientRect();
    panneau.style.top = nb.bottom + 'px';
    const largeur = panneau.offsetWidth;
    const left = Math.min(Math.max(16, bb.left), window.innerWidth - largeur - 16);
    panneau.style.left = left + 'px';
  }

  function ouvrir() {
    if (nav.getBoundingClientRect().top > 1) {
      nav.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
    positionner();
    panneau.classList.add('ouvert');
    btnFiltres.setAttribute('aria-expanded', 'true');
  }

  function fermer() {
    panneau.classList.remove('ouvert');
    btnFiltres.setAttribute('aria-expanded', 'false');
  }

  btnFiltres.addEventListener('click', function() {
    panneau.classList.contains('ouvert') ? fermer() : ouvrir();
  });

  document.addEventListener('click', function(e) {
    if (!panneau.classList.contains('ouvert')) return;
    if (panneau.contains(e.target) || btnFiltres.contains(e.target)) return;
    fermer();
  });

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') fermer();
  });

  window.addEventListener('scroll', function() {
    if (panneau.classList.contains('ouvert')) positionner();
  }, { passive: true });
  window.addEventListener('resize', function() {
    if (panneau.classList.contains('ouvert')) positionner();
  });

  function appliquerFiltres() {
    const rolesChoisis = checks.filter(c => c.checked).map(c => c.value);
    const tri = radios.find(r => r.checked).value;

    cards.forEach(function(card) {
      const roles = JSON.parse(card.getAttribute('data-roles') || '[]');
      const visible = rolesChoisis.length === 0 || rolesChoisis.some(r => roles.includes(r));
      card.classList.toggle('masque', !visible);
    });

    const cardsVisibles = cards.filter(c => !c.classList.contains('masque'));
    cardsVisibles.sort(function(a, b) {
      const anneeA = parseInt(a.getAttribute('data-annee') || '0');
      const anneeB = parseInt(b.getAttribute('data-annee') || '0');
      return tri === 'asc' ? anneeA - anneeB : anneeB - anneeA;
    });
    cardsVisibles.forEach(function(card) { filmsListe.appendChild(card); });

    const nbFiltres = rolesChoisis.length + (tri !== 'desc' ? 1 : 0);
    badge.textContent = String(nbFiltres);
    badge.classList.toggle('visible', nbFiltres > 0);
    filtreReset.classList.toggle('visible', nbFiltres > 0);
    resultat.textContent = cardsVisibles.length + (cardsVisibles.length > 1 ? ' films' : ' film');
  }

  checks.forEach(c => c.addEventListener('change', appliquerFiltres));
  radios.forEach(r => r.addEventListener('change', appliquerFiltres));

  filtreReset.addEventListener('click', function() {
    checks.forEach(c => { c.checked = false; });
    radios.forEach(r => { r.checked = r.value === 'desc'; });
    appliquerFiltres();
  });

  appliquerFiltres();

  // ── LIGHTBOX ──
  let currentPhotos = [];
  let currentIndex = 0;

  const lightbox = document.getElementById('lightbox');
  const lightboxImg = document.getElementById('lightbox-img');
  const lightboxBg = document.getElementById('lightbox-bg');
  const lightboxClose = document.getElementById('lightbox-close');
  const lightboxPrev = document.getElementById('lightbox-prev');
  const lightboxNext = document.getElementById('lightbox-next');
  const lightboxCounter = document.getElementById('lightbox-counter');

  function openLightbox(photos, index) {
    currentPhotos = photos;
    currentIndex = index;
    showPhoto();
    lightbox.classList.add('open');
  }

  function closeLightbox() {
    lightbox.classList.remove('open');
  }

  function showPhoto() {
    lightboxImg.style.opacity = '0';
    setTimeout(() => {
      lightboxImg.src = currentPhotos[currentIndex];
      lightboxImg.style.opacity = '1';
    }, 150);
    lightboxCounter.textContent = (currentIndex + 1) + ' / ' + currentPhotos.length;
  }

  document.querySelectorAll('.film-mosaique').forEach(function(mosaique) {
    const photos = JSON.parse(mosaique.dataset.photos);
    mosaique.querySelectorAll('.mosaique-item').forEach(function(btn) {
      btn.addEventListener('click', function() {
        openLightbox(photos, parseInt(btn.dataset.index));
      });
    });
  });

  lightboxClose.addEventListener('click', closeLightbox);
  lightboxBg.addEventListener('click', closeLightbox);

  lightboxPrev.addEventListener('click', function() {
    currentIndex = (currentIndex - 1 + currentPhotos.length) % currentPhotos.length;
    showPhoto();
  });

  lightboxNext.addEventListener('click', function() {
    currentIndex = (currentIndex + 1) % currentPhotos.length;
    showPhoto();
  });

  document.addEventListener('keydown', function(e) {
    if (!lightbox.classList.contains('open')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') {
      currentIndex = (currentIndex - 1 + currentPhotos.length) % currentPhotos.length;
      showPhoto();
    }
    if (e.key === 'ArrowRight') {
      currentIndex = (currentIndex + 1) % currentPhotos.length;
      showPhoto();
    }
  });
</script>